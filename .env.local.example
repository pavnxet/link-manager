# Database Provider Choice ('supabase' or 'turso')
DB_PROVIDER=supabase

# Supabase
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Turso
TURSO_DATABASE_URL=YOUR_TURSO_DATABASE_URL
TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN

# Admin Access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secret

# Session signing key. REQUIRED in production: without it the app refuses to issue auth tokens
# (an unset secret used to fall back to a constant published in this repo, so anyone could forge a
# login cookie). Use 32+ random characters, e.g. `openssl rand -base64 32`.
JWT_SECRET=replace-with-a-long-random-string

# ImgBB image uploads (server-side only — never exposed to the browser)
# Get a key at https://api.imgbb.com/
IMGBB_API_KEY=YOUR_IMGBB_API_KEY

# Canonical site URL used in metadata (Open Graph, robots, sitemap)
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
